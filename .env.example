# TMDB credentials and endpoint used by src/extract.py
TMDB_ACCESS_TOKEN=replace_with_tmdb_access_token
URL=https://api.themoviedb.org/3/movie/popular

# MongoDB root account (used by Docker Compose)
MONGO_INITDB_ROOT_USERNAME=movieshub
MONGO_INITDB_ROOT_PASSWORD=replace_with_a_strong_password
MONGO_URI=mongodb://movieshub:replace_with_a_strong_password@localhost:27017/?authSource=admin

# Mongo Express login
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=replace_with_a_strong_password

# Optional Airflow host UID for mounted files
AIRFLOW_UID=50000
